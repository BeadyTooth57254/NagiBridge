<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <EnableHarmonyTranspilerSupport>true</EnableHarmonyTranspilerSupport>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Renamed from the upstream branding (NagiBridge) to 麦垛/WheatStook. -->
    <AssemblyName>WheatStook</AssemblyName>
    <!-- Deploy to the actual mod folder Es uses. -->
    <ModFolderName>[AI聊天]麦垛 WheatStook</ModFolderName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Clean-room rewrite: compile only the original source. ChatHud is now our own
      clean-room rewrite, so it IS compiled. LlmClient and everything under mods\
      are excluded here and migrated (replaced with original code) piece by piece.
      Update this list as those are rewritten.
    -->
    <Compile Remove="LlmClient.cs" />
    <Compile Remove="mods\**" />
  </ItemGroup>

  <!--
    Pathoschild.Stardew.ModBuildConfig auto-detects the local Stardew Valley
    install (Steam / GOG / Xbox, on Windows / macOS / Linux) and references
    Stardew Valley.dll, SMAPI, MonoGame, xTile and Harmony for you, so there
    are no machine-specific paths to edit. Override the path if auto-detect
    fails: set the GamePath property or a GAME_PATH environment variable.
    Docs: https://github.com/Pathoschild/SMAPI/blob/develop/docs/technical/mod-package.md
  -->
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.*" />
    <PackageReference Include="Lib.Harmony" Version="2.*" />
  </ItemGroup>
</Project>
